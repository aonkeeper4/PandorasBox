# -- Entity and Trigger Tooltips -- 
#    placements.entities.entityName.tooltips.attr=Tooltip
#    placements.triggers.triggerName.tooltips.attr=Tooltip

# -- Entities -- 

# TimeField
placements.entities.pandorasBox/timefield.tooltips.start=The speed multiplier set when entering the field or moving for "startTime" seconds inside.
placements.entities.pandorasBox/timefield.tooltips.stop=The speed multiplier set when exiting the field or while standing still for "stopTime" seconds inside.
placements.entities.pandorasBox/timefield.tooltips.stopTime=Time required to stand still to reach the "stop" speed multiplier.
placements.entities.pandorasBox/timefield.tooltips.startTime=Time required to be moving to reach the "start" speed multiplier.
placements.entities.pandorasBox/timefield.tooltips.animRate=The speed of the animation of the field.
placements.entities.pandorasBox/timefield.tooltips.render=If the field should render at all.
placements.entities.pandorasBox/timefield.tooltips.lingering=If the effect should last after exiting the field until a new lingering field is entered.
placements.entities.pandorasBox/timefield.tooltips.color=The color of the particles.\nHex values can be used.
placements.entities.pandorasBox/timefield.tooltips.respectOtherTimeRates=If the timefield should attempt to respect other time rates. This includes things like Crystal Heart and Seekers. Can cause some weird oddities in certain interactions, such as Seeker slowdown.

# Shells
placements.entities.pandorasBox/shell.tooltips.texture=What version of the shell should be used. Path is "objects/pandorasBox/shells/$texture/", where $texture is your input. Look at the assets to see structure.
placements.entities.pandorasBox/shell.tooltips.lights=If the shell should be a light source.
placements.entities.pandorasBox/shell.tooltips.color=The color of the shell tinting\n"Color1,Color2,Color3" for color animations.
placements.entities.pandorasBox/shell.tooltips.direction=The start direction of the shell\n-1: Left\n0: Stand still\n1: Right.
placements.entities.pandorasBox/shell.tooltips.colorSpeed=How fast the colors cycles.
placements.entities.pandorasBox/shell.tooltips.grabbable=Whether the player should be able to pick up the shell or not.
placements.entities.pandorasBox/shell.tooltips.dangerous=Whether landing on top of the shell should kill the player or not.

# Dash Toggle Blocks
placements.entities.pandorasBox/dashToggleBlock.tooltips.divisor=Divisor used for the counter looping
placements.entities.pandorasBox/dashToggleBlock.tooltips.index=The index where the block is solid.\n"0,1" for multiple indices.

# Colored Water
placements.entities.pandorasBox/coloredWater.tooltips.color=The color of the water.\nHex values can be used.
placements.entities.pandorasBox/coloredWater.tooltips.hasTop=Determines whether or not the water has a top surface.
placements.entities.pandorasBox/coloredWater.tooltips.hasBottom=Determines whether or not the water has a bottom surface.
placements.entities.pandorasBox/coloredWater.tooltips.hasLeft=Determines whether or not the water has a left surface.
placements.entities.pandorasBox/coloredWater.tooltips.hasRight=Determines whether or not the water has a right surface.

# Colored Waterfall
placements.entities.pandorasBox/coloredWaterfall.tooltips.color=The color of the waterfall.\nHex values can be used.

# Colored Big Waterfall
placements.entities.pandorasBox/coloredBigWaterfall.tooltips.color=The color of the waterfall.\nHex values can be used.
placements.entities.pandorasBox/coloredBigWaterfall.tooltips.layer=Where the waterfall should render.\nFG is in the foreground.\nBG is in the background and parallaxes.

# Intro Car
placements.entities.pandorasBox/introCar.tooltips.acceleration=How fast the car accelerates.
placements.entities.pandorasBox/introCar.tooltips.deceleration=How fast the car decelerates.
placements.entities.pandorasBox/introCar.tooltips.maxSpeed=The highest speed the car can have.
placements.entities.pandorasBox/introCar.tooltips.brokenDoor=If the door is broken and the player can not get out after entering.
placements.entities.pandorasBox/introCar.tooltips.keepCarSpeedOnExit=If the player should keep their speed when exiting the car. Also launches upwards if the car is driving fast.
placements.entities.pandorasBox/introCar.tooltips.nitroAcceleration=How fast the car accelerates while using nitro.
placements.entities.pandorasBox/introCar.tooltips.nitroMaxDuration=The maximum duration nitro can last without refilling it.
placements.entities.pandorasBox/introCar.tooltips.nitroRegenMultiplier=How fast the nitro replenishes while not using it.
placements.entities.pandorasBox/introCar.tooltips.facing=The start direction of the car.
placements.entities.pandorasBox/introCar.tooltips.deceleration=How fast the car decelerates.

# Pandora's Box
placements.entities.pandorasBox/pandorasBox.tooltips.completeChapter=If opening the box should complete the chapter.
placements.entities.pandorasBox/pandorasBox.tooltips.dialog=Custom dialog for the postcard.\nLeave empty for default dialogs.

# Tile Glitcher
placements.entities.pandorasBox/tileGlitcher.tooltips.rate=How long to wait between each glitching attempt.
placements.entities.pandorasBox/tileGlitcher.tooltips.threshold=How likely a tile is to change itself.
placements.entities.pandorasBox/tileGlitcher.tooltips.target=What tiles the glitcher should target.
placements.entities.pandorasBox/tileGlitcher.tooltips.customFgTiles=What FG tiles glitcher should use, instead of all available.\nString of all chars, no seperator.\nGame will crash if the ID doesn't exist.
placements.entities.pandorasBox/tileGlitcher.tooltips.customBgTiles=What BG tiles glitcher should use, instead of all available.\nString of all chars, no seperator.\nGame will crash if the ID doesn't exist.
placements.entities.pandorasBox/tileGlitcher.tooltips.allowAir=If the glitcher can replace a tile with air. Ignored if custom tiles is set.
placements.entities.pandorasBox/tileGlitcher.tooltips.transformAir=If the glitcher can replace air with other tiles.
placements.entities.pandorasBox/tileGlitcher.tooltips.flag=Flag to activate the glitcher, leave empty to always enable.\nUse ',' to activate on any flag, for example "foo,bar,baz".

# Dust Sprite Color Controller
placements.entities.pandorasBox/dustSpriteColorController.tooltips.eyeColor=The eye color.\nHex values can be used.
placements.entities.pandorasBox/dustSpriteColorController.tooltips.borderColor=Three colors for the border.\nSeperated by ',', example "Red,Blue,Green".\nHex values can be used.
placements.entities.pandorasBox/dustSpriteColorController.tooltips.eyeTexture=The eye texture.

# Circular Resort Platforms
placements.entities.pandorasBox/circularResortPlatform.tooltips.speed=The rotating speed.
placements.entities.pandorasBox/circularResortPlatform.tooltips.texture=What texture to use for the platform.
placements.entities.pandorasBox/circularResortPlatform.tooltips.attachToSolid=If the platform should attach to solids.
placements.entities.pandorasBox/circularResortPlatform.tooltips.clockwise=If the platform should rotate clockwise.
placements.entities.pandorasBox/circularResortPlatform.tooltips.particles=If the platform should emit particles.
placements.entities.pandorasBox/circularResortPlatform.tooltips.renderRail=If the platform rail should render.
placements.entities.pandorasBox/circularResortPlatform.tooltips.lineEdgeColor=The rail edge color.
placements.entities.pandorasBox/circularResortPlatform.tooltips.lineFillColor=The rail fill color.
placements.entities.pandorasBox/circularResortPlatform.tooltips.rotationFix=Fixes initial rotation of platform.

# Lever
placements.entities.pandorasBox/lever.tooltips.flag=The flag the lever sets/unsets.
placements.entities.pandorasBox/lever.tooltips.active=The starting position of the lever.

# Player Clone
placements.entities.pandorasBox/playerClone.tooltips.flag=The flag to activate the player clone. Setting the flag spawns it, unsetting removes it.
placements.entities.pandorasBox/playerClone.tooltips.mode=The visual apperance of the clone.\nInventory - Madeline with the same backpack status as current inventory.\nBackpack - Madeline with backpack.\nNoBackpack - Madeline without a backpack.\MadelineAsBadeline - Badeline.

# Light Emmiter
placements.entities.pandorasBox/laserEmitter.tooltips.flag=Flag to activate the emitter.
placements.entities.pandorasBox/laserEmitter.tooltips.color=The color of the laser from the emitter.
placements.entities.pandorasBox/laserEmitter.tooltips.direction=The direction the laser is emitted.
placements.entities.pandorasBox/laserEmitter.tooltips.beamDuration=How long the laser lasts before disappearing.\n-1 means never.
placements.entities.pandorasBox/laserEmitter.tooltips.inverted=If the flag behavior of the emitter is inverted.

# Laser Note Block
placements.entities.pandorasBox/laserNoteBlock.tooltips.atPlayer=If the sound should play at the player location, rather than at the noteblock.
placements.entities.pandorasBox/laserNoteBlock.tooltips.pitch=MIDI pitch.\n69 = A4.
placements.entities.pandorasBox/laserNoteBlock.tooltips.volume=Volume to play the note at.
placements.entities.pandorasBox/laserNoteBlock.tooltips.sound=The sound to play.
placements.entities.pandorasBox/laserNoteBlock.tooltips.direction=Where the opening for the laser is.

# Laser Mirror
placements.entities.pandorasBox/laserMirror.tooltips.opening=Which direcitons the mirror can reflect in.

# Laser Sensor
placements.entities.pandorasBox/laserSensor.tooltips.flag=Which flag the sensor sets when active.
placements.entities.pandorasBox/laserSensor.tooltips.blockLight=Whether the sensor should block light from passing through or not.
placements.entities.pandorasBox/laserSensor.tooltips.color=The required color to active the sensor.
placements.entities.pandorasBox/laserSensor.tooltips.mode=The method of activating the sensor.\nContinous - Requires the light to stay on it for the flag to be set.\nHit Once - Sets the flag when it is hit, resets when the flag is unset from other sources.

# Laser Valve
placements.entities.pandorasBox/laserValve.tooltips.delay=How many frames the valve takes to let a laser through.\nCeleste runs at a constant 60 frames per second, approximately 0.01667 seconds per frame.
placements.entities.pandorasBox/laserValve.tooltips.direction=Where the opening for the laser is.

# Lamp
placements.entities.pandorasBox/lamp.tooltips.flag=Flag to activate the lamp.
placements.entities.pandorasBox/lamp.tooltips.inverted=Inverts the flag value for activation.
placements.entities.pandorasBox/lamp.tooltips.baseColor=The color of the lamp base. Can be used to indicate what light is needed to open it.
placements.entities.pandorasBox/lamp.tooltips.lightColor=The color of the actual light coming of the lamp.
placements.entities.pandorasBox/lamp.tooltips.lightMode=How the lamp lights should function.
placements.entities.pandorasBox/lamp.tooltips.lightStartRadius=Start radius of light. This is a VertexLight property, not used for the "Smooth" light mode!
placements.entities.pandorasBox/lamp.tooltips.lightEndRadius=End radius of light. This is a VertexLight property, not used for the "Smooth" light mode!

# Gate
placements.entities.pandorasBox/gate.tooltips.flag=Flag to activate the gate.
placements.entities.pandorasBox/gate.tooltips.inverted=If the flag behavior of the gate is inverted.
placements.entities.pandorasBox/gate.tooltips.texture=The folder to look for gate texture in. Looks for gate*.png in the specified folder.\nBy default it points at "objects/pandorasBox/gate/", meaning it uses "objects/pandorasBox/gate/gate0.png" and so on.

# Water Drowning Controoller
placements.entities.pandorasBox/waterDrowningController.tooltips.maxDuration=How long it takes for Madeline to drown in water.
placements.entities.pandorasBox/waterDrowningController.tooltips.mode=How the controller should operate.\nDiving - Only counts when Madeline is actually diving in the water.\nSwimming - Counts as long as Madeline is in water.

# Air Bubbles
placements.entities.pandorasBox/airBubbles.tooltips.oneUse=If the air bubble should only be usable once. Resets when room is reloaded or the player dies.

# Flag Toggle Switch
placements.entities.pandorasBox/flagToggleSwitch.tooltips.onlyOn=If the switch should only be able to activate the flag.
placements.entities.pandorasBox/flagToggleSwitch.tooltips.onlyOff=If the switch should only be able to deactivate the flag.
placements.entities.pandorasBox/flagToggleSwitch.tooltips.silent=Whether the switch should make sounds when it is toggled or not.
placements.entities.pandorasBox/flagToggleSwitch.tooltips.flag=Which flag the switch sets when active.

# Dream Dash Controller
placements.entities.pandorasBox/dreamDashController.tooltips.allowSameDirectionDash=If the player should be able to dash in the direction they are currently dashing.
placements.entities.pandorasBox/dreamDashController.tooltips.allowDreamDashRedirect=If the player should be able to dash in a new direction while in space jam.
placements.entities.pandorasBox/dreamDashController.tooltips.overrideDreamDashSpeed=Whether the space jam should use custom speed.
placements.entities.pandorasBox/dreamDashController.tooltips.neverSlowDown=Player will use and keep speed it has on entry if it is faster than a normal dream dash.
placements.entities.pandorasBox/dreamDashController.tooltips.useEntrySpeedAngle=Whether the entry angle should be used rather than the dash angle when entering a block. This is intended to be used together with the never slow down option, as it allows entering the space jam at "ultra" angles.
placements.entities.pandorasBox/dreamDashController.tooltips.bounceOnCollision=Whether the player should bounce when hitting solids rather than die. Does not bounce directly back like Assist Mode invincibility.
placements.entities.pandorasBox/dreamDashController.tooltips.stickOnCollision=Whether the player should stick to the wall when hitting solids rather than die. Setting is ignored if Bounce on Collision is active.
placements.entities.pandorasBox/dreamDashController.tooltips.overrideColors=Whether the space jam in the room should use the colors from this controller.
placements.entities.pandorasBox/dreamDashController.tooltips.sameDirectionSpeedMultiplier=The speed multiplier if the player dashes in the same direction. Allow Same Direction Dash must be enabled.
placements.entities.pandorasBox/dreamDashController.tooltips.dreamDashSpeed=The speed when entering a space jam. Override Dream Dash Speed must be enabled.
placements.entities.pandorasBox/dreamDashController.tooltips.activeLineColor=Line color for active space jam. Override Colors must be enabled.
placements.entities.pandorasBox/dreamDashController.tooltips.disabledLineColor=Line color for deactivated space jam. Override Colors must be enabled.
placements.entities.pandorasBox/dreamDashController.tooltips.activeBackColor=Background color for active space jam. Override Colors must be enabled.
placements.entities.pandorasBox/dreamDashController.tooltips.disabledBackColor=Background color for deactivated space jam. Override Colors must be enabled.
placements.entities.pandorasBox/dreamDashController.tooltips.particleLayer0Colors=Colors for particle layer 0, multiple colors can be used with "," as separator. Override Colors must be enabled.
placements.entities.pandorasBox/dreamDashController.tooltips.particleLayer1Colors=Colors for particle layer 1, multiple colors can be used with "," as separator. Override Colors must be enabled.
placements.entities.pandorasBox/dreamDashController.tooltips.particleLayer2Colors=Colors for particle layer 2, multiple colors can be used with "," as separator. Override Colors must be enabled.

# Entity Activator
placements.entities.pandorasBox/entityActivator.tooltips.flag=Which flag should activate the entity when a flag based activation mode is used.
placements.entities.pandorasBox/entityActivator.tooltips.useTracked=If the targets should be selected with their tracked name or their class names. Tracked is prefered for performance, but not all entities are tracked.
placements.entities.pandorasBox/entityActivator.tooltips.targets=Which targets the entity should look for. This uses the full class name of the entity for example "Celeste.Player". Internal classes can be used by doing "classname+internalclass" for example "Celeste.ZipMover+ZipMoverPathRenderer". Multiple targets can be specified with "," as separator.
placements.entities.pandorasBox/entityActivator.tooltips.mode=What the entity does when activated. The following modes are supported:\n - ActivateInsideDeactiveInside - All targets inside are activated and all targets outside are deactivated\n - ActivateInside - All targets inside are activated\n - DeactivateInside - All targets inside are deactivated\n - ActivateOutside - All targets outside are activated\n - DeactivateOutside - All targets outside are deactivated\n - ActivateOnScreenDeactivateOffScreen - All targets that are visible on camera (or slightly outside) are activated and those outside are deactivated
placements.entities.pandorasBox/entityActivator.tooltips.activationMode=What condition actviates the entity. The following modes are supported:\n - OnEnte - When the player enters the entity\n - OnStay - While the player is in the entity\n - OnLeave - When the player leaves the entity\n - OnFlagActive - While the flag is active (set)\n - OnFlagInactive - While the flag is inactive (unset)\n - OnFlagActivated - When the flag is active after being inactive\n - OnFlagDectivated - When the flag is inactive after being active\n - OnUpdate - While the entity is active\n - OnAwake - When the scene is ready\n - OnCameraMoved - When the camera is moved at least one tile in any direction
placements.entities.pandorasBox/entityActivator.tooltips.updateInterval=How often the entity activates when using activation modes that activate repeatedly under a meet condition. Leave as -1 for every frame, however this might be expensive.

# Propeller Box
placements.entities.pandorasBox/propellerBox.tooltips.maxCharges=The amount of charges the propeller box can have.
placements.entities.pandorasBox/propellerBox.tooltips.texture=The texture to use for the propeller box. Path is "objects/pandorasBox/propellerBox/$texture/", where $texture is your input. Look at the assets to see structure.
placements.entities.pandorasBox/propellerBox.tooltips.flashUseColor=The flash color when using a charge.
placements.entities.pandorasBox/propellerBox.tooltips.flashChargeColor=The flash color when recharging.
placements.entities.pandorasBox/propellerBox.tooltips.glideMode=When the jellyfish "slow fall" effect should be active.\nAlways - Always active\nAfter Using Charge - After using a charge until landing.\nNever - Never.
placements.entities.pandorasBox/propellerBox.tooltips.rechargeOnGround=Whether the propeller box should get more charges when landing.

# Clear Pipes
placements.entities.pandorasBox/clearPipe.tooltips.texture=The texture to use for the clear pipe. Path is "objects/pandorasBox/clearPipe/$texturePath/", where $texture is your input. Look at the assets to see structure.
placements.entities.pandorasBox/clearPipe.tooltips.surfaceSound=Override default surface sound. Leave at -1 for default.
placements.entities.pandorasBox/clearPipe.tooltips.hasPipeSolids=Whether the pipe should spawn solids or not.
placements.entities.pandorasBox/clearPipe.tooltips.transportSpeed=Which speed the pipe should transport entites at. Speed is pixels per second.
placements.entities.pandorasBox/clearPipe.tooltips.pipeWidth=Width of the pipe. Might cause visual oddities with non multiples of 8.

